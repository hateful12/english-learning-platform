generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String?
  passwordHash      String
  createdAt         DateTime            @default(now())
  homework          Homework[]
  lessonLinks       LessonLink[]
  miroLinks         MiroLink[]
  paymentInfos      PaymentInfo[]
  invites           Invite[]
  homeworkResponses HomeworkResponse[]
  groups            StudentGroup[]
  scheduledLessons  ScheduledLesson[]
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime?
  usedAt    DateTime?
  createdAt DateTime @default(now())
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model Homework {
  id          String   @id @default(cuid())
  title       String
  description String
  attachments String   @default("[]") // JSON array of { url, name, type }
  status      String   @default("active") // "active" | "closed"
  studentId   String?
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  responses   HomeworkResponse[]
}

model HomeworkResponse {
  id                         String    @id @default(cuid())
  homeworkId                 String
  studentId                  String
  response                   String
  submittedAt                DateTime  @default(now())
  teacherFeedback            String?
  teacherFeedbackAttachments String    @default("[]") // JSON array of { url, name, type }
  feedbackAt                 DateTime?
  homework                   Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student                    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([homeworkId, studentId])
}

model LessonLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  studentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model MiroLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  studentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model PaymentInfo {
  id        String   @id @default(cuid())
  content   String
  amount    String?
  studentId String?
  updatedAt DateTime @updatedAt
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("teacher") // "admin" can manage homeworks, links, payment
  createdAt    DateTime @default(now())
}

model Group {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now())
  students         StudentGroup[]
  homework         Homework[]
  scheduledLessons ScheduledLesson[]
}

model StudentGroup {
  studentId String
  groupId   String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([studentId, groupId])
}

model ScheduledLesson {
  id          String   @id @default(cuid())
  title       String
  startAt     DateTime
  durationMin Int      @default(60)
  zoomUrl     String?
  notes       String?
  studentId   String?
  groupId     String?
  createdAt   DateTime @default(now())
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

// Tracks teacher closing a group homework for an individual student
model HomeworkStudentClose {
  homeworkId String
  studentId  String
  closedAt   DateTime @default(now())
  @@id([homeworkId, studentId])
}
