generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id                  String                @id @default(cuid())
  email               String                @unique
  name                String?
  passwordHash        String
  paymentCode         String                @unique @default(cuid())
  paymentCents        Int?                  // 1-99, permanent unique ID kopecks for any-bank matching
  lessonPrice         Int?
  level               String?              // CEFR level set by teacher: "A1" "A2" "B1" "B2" "C1" "C2"
  teacherId           String?              // legacy primary teacher; use TeacherStudent for multi-teacher
  isPaused            Boolean              @default(false)
  pausedAt            DateTime?
  createdAt           DateTime              @default(now())
  teacher             Teacher?              @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherStudents     TeacherStudent[]
  homework            Homework[]
  homeworkReminders   HomeworkReminder[]
  paymentInfos        PaymentInfo[]
  invites             Invite[]
  homeworkResponses   HomeworkResponse[]
  groups              StudentGroup[]
  scheduledLessons    ScheduledLesson[]
  payments            Payment[]
  groupLessonPayments GroupLessonPayment[]
  paymentIntents      PaymentIntent[]
  assessments               Assessment[]
  wordleGames               WordleGame[]
  speakingPracticePrompts   SpeakingPracticePrompt[]
}

// Per-question history for AI speaking practice (speaking-prep); used to avoid repeats.
model SpeakingPracticePrompt {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level     String // CEFR band at generation time
  question  String
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

model WordleGame {
  id         String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  result    String   // "won" | "lost"
  tries     Int      // 1-6 for won, 7 for lost
  playedAt  DateTime @default(now())
  @@unique([studentId, date])
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime?
  usedAt    DateTime?
  createdAt DateTime @default(now())
  studentId String?
  createdByTeacherId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdByTeacher Teacher? @relation("StudentInvitesCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: SetNull)
}

model Homework {
  id          String   @id @default(cuid())
  emoji       String   @default("") // kept for backwards compat; emoji now in title/description
  title       String
  description String
  attachments String   @default("[]") // JSON array of { url, name, type }
  status      String   @default("active") // "active" | "closed"
  studentId   String?
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  responses   HomeworkResponse[]
  reminders   HomeworkReminder[]
}

// Email reminder the evening (17:00 local) before the calendar day of the student's next lesson
model HomeworkReminder {
  id          String    @id @default(cuid())
  homeworkId  String
  studentId   String
  scheduledAt DateTime
  sentAt      DateTime?
  lessonId    String?
  createdAt   DateTime  @default(now())
  homework    Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([homeworkId, studentId])
}

model HomeworkResponse {
  id                         String    @id @default(cuid())
  homeworkId                 String
  studentId                  String
  response                   String
  studentResponseAttachments  String    @default("[]") // JSON array of { url, name, type }
  submittedAt                DateTime  @default(now())
  teacherFeedback            String?
  teacherFeedbackAttachments String    @default("[]") // JSON array of { url, name, type }
  feedbackAt                 DateTime?
  homework                   Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student                    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([homeworkId, studentId])
}

model PaymentInfo {
  id        String   @id @default(cuid())
  content   String
  amount    String?
  studentId String?
  updatedAt DateTime @updatedAt
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("teacher") // "teacher" | "super-admin"
  createdAt    DateTime @default(now())
  students     Student[]
  groups       Group[]
  studentInvites Invite[] @relation("StudentInvitesCreatedBy")
  teacherInvitesCreated TeacherInvite[] @relation("TeacherInvitesCreatedBy")
  teacherStudents TeacherStudent[]
}

// Many-to-many: a student can have multiple teachers
model TeacherStudent {
  teacherId  String
  studentId  String
  createdAt  DateTime @default(now())
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([teacherId, studentId])
}

model TeacherInvite {
  id                 String   @id @default(cuid())
  token              String   @unique
  email              String?
  expiresAt          DateTime?
  usedAt             DateTime?
  createdAt          DateTime @default(now())
  createdByTeacherId String?
  createdTeacherId   String?
  createdByTeacher   Teacher? @relation("TeacherInvitesCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: SetNull)
}

model Group {
  id               String            @id @default(cuid())
  name             String
  lessonPrice      Int?
  teacherId        String?
  createdAt        DateTime          @default(now())
  teacher          Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  students         StudentGroup[]
  homework         Homework[]
  scheduledLessons ScheduledLesson[]
}

model StudentGroup {
  studentId String
  groupId   String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([studentId, groupId])
}

model ScheduledLesson {
  id                  String               @id @default(cuid())
  title               String
  startAt             DateTime
  durationMin         Int                  @default(60)
  zoomUrl             String?
  notes               String?
  studentId           String?
  groupId             String?
  isPaid              Boolean              @default(false)
  paymentId           String?
  createdAt           DateTime             @default(now())
  student             Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group               Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payment             Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  groupLessonPayments GroupLessonPayment[]
}

// Tracks teacher closing a group homework for an individual student
model HomeworkStudentClose {
  homeworkId String
  studentId  String
  closedAt   DateTime @default(now())
  @@id([homeworkId, studentId])
}

// Tracks student hiding an archived homework item from their own view
model HomeworkStudentHide {
  homeworkId String
  studentId  String
  hiddenAt   DateTime @default(now())
  @@id([homeworkId, studentId])
}

model Payment {
  id                  String               @id @default(cuid())
  studentId           String
  monoId              String               @unique
  amount              Int
  lessonsCount        Int                  @default(1)
  comment             String?
  receivedAt          DateTime
  createdAt           DateTime             @default(now())
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessons             ScheduledLesson[]
  groupLessonPayments GroupLessonPayment[]
}

model GroupLessonPayment {
  studentId  String
  lessonId   String
  isPaid     Boolean          @default(false)
  paymentId  String?
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson     ScheduledLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  payment    Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@id([studentId, lessonId])
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// Unique-amount payment intent for matching transfers from any bank (no comment code needed)
model PaymentIntent {
  id              String   @id @default(cuid())
  studentId       String
  requestedAmount Int      // kopecks — what the student selected to pay
  uniqueAmount    Int      // kopecks — requestedAmount + 1-99 random kopecks (used for matching)
  status          String   @default("pending") // "pending" | "matched" | "expired" | "manual_review"
  expiresAt       DateTime
  paymentId       String?  // Payment.id once matched
  createdAt       DateTime @default(now())
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([uniqueAmount, status])
}

model Assessment {
  id          String               @id @default(cuid())
  studentId   String
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      String               @default("pending") // "pending" | "completed"
  level       String?              // "A1" "A2" "B1" "B2" "C1" "C2"
  skill       String?              // "reading" | "writing" | "listening" | "speaking"
  score       Int?                 // 0-100
  feedback    String?
  questions   AssessmentQuestion[]
  createdAt   DateTime             @default(now())
  completedAt DateTime?
}

model AssessmentQuestion {
  id                  String     @id @default(cuid())
  assessmentId        String
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order               Int
  questionType        String     @default("mcq") // "mcq" | "open"
  question            String
  options             String     // JSON array of 4 answer options (empty for open)
  correctAnswer       String     // for mcq: exact option text; for open: often empty
  studentAnswer       String?
  listeningTranscript String? // listening: script for TTS; optional reveal in UI
  audioUrl            String? // listening: /assessment-audio/{id}.mp3
}
