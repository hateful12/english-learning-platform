    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.1",
    "next": "14.2.15",
    "nodemailer": "^8.0.4",
    "openai": "^6.29.0",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "jimp": "^1.6.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
