{
  "name": "english-learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('.next')){ fs.rmSync('.next',{recursive:true}); console.log('Cleaned .next'); } else { console.log('.next not found'); }\"",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:backup": "node scripts/backup-sqlite-db.js",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
