# Required for Progress Test (AI-powered assessment)
# Use .env.local on localhost (gitignored); then restart `npm run dev`.
# OPENAI_API_KEY=sk-...
# Project-scoped keys (sk-proj-...) also need the project id (copy from production or OpenAI → Project settings):
# OPENAI_PROJECT_ID=proj_...
# If your org uses it (same as on the server):
# OPENAI_ORG_ID=org-...
