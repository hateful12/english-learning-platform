# Path relative to project root when running Next.js
DATABASE_URL="file:./prisma/dev.db"
TEACHER_PASSWORD=changeme
NEXTAUTH_SECRET=your-secret-for-sessions

# Public URL for invite links and Monobank webhook (required on VPS)
# APP_URL=https://194.61.52.14.nip.io
# APP_URL=https://senira.english.com

# Optional: Monobank Corporate API webhook verification (Personal API does not use X-Sign)
# MONOBANK_WEBHOOK_PUBLIC_KEY=

# Required for Progress Test (AI-powered assessment)
# Use .env.local on localhost (gitignored); then restart `npm run dev`.
# OPENAI_API_KEY=sk-...
# Project-scoped keys (sk-proj-...) also need the project id (copy from production or OpenAI → Project settings):
# OPENAI_PROJECT_ID=proj_...
# If your org uses it (same as on the server):
# OPENAI_ORG_ID=org-...

# Homework email reminders (evening before lesson day at 17:00 in this timezone)
# HOMEWORK_REMINDER_TIMEZONE=Europe/Kyiv
# Gmail (App password: Google Account → Security → 2-Step Verification → App passwords)
# Put these in .env.local (not committed). Restart dev server after changes.
# Use the same Google account for GMAIL_USER and the app password.
# GMAIL_USER=your.address@gmail.com
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Aliases also work: EMAIL_USER + EMAIL_APP_PASSWORD, or SMTP_USER + SMTP_PASS.
# (Spaces in the password are OK; you can also paste without spaces.)
# CRON_SECRET=long-random-string
# Call POST /api/cron/homework-reminders with Authorization: Bearer <CRON_SECRET> on a schedule (e.g. hourly).
# Local dev without sending mail: HOMEWORK_REMINDER_LOG_ONLY=1
